# =============================================================================
# .gitignore — PulseHire
# =============================================================================
# This file tells Git what to NEVER track. Critical for keeping secrets safe.
# =============================================================================

# ----- Environment & Secrets -----
# ⚠️ MOST IMPORTANT: never commit your real .env file
.env
.env.local
.env.development
.env.production
.env.*.local
!.env.example     # .env.example IS tracked (it's a template)

# ----- API Keys & Credentials -----
*.pem
*.key
*.cert
secrets/
credentials.json
config/local.json

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ----- Node / React -----
node_modules/
.pnp
.pnp.js
dist/
build/
.vite/
*.local
coverage/

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
scraper.log
backend.log

# ----- Database -----
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-journal
# Exception: keep the .gitkeep so the folder exists
!backend/data/.gitkeep

# ----- IDE & Editor -----
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ----- OS Files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ----- Test Artifacts -----
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ----- Scraper Output -----
scraped_data/
raw_html/
*.html.bak
